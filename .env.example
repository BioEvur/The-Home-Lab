# The Home Lab — environment variables.
# Copy to .env.local for development. Every value is optional: anything left
# blank makes the related feature show an explicit "not connected" state.
# Variables starting NEXT_PUBLIC_ are sent to the browser. Never put a secret
# in a NEXT_PUBLIC_ variable.

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "development" (default) shows the development notice and placeholder markers
# and blocks search engines. Set to "production" only at launch.
NEXT_PUBLIC_SITE_STAGE=development
# Optional announcement strip text. Only use a message that is true.
NEXT_PUBLIC_ANNOUNCEMENT=

# ─── Shopify (server only) ─────────────────────────────────────────────────
# e.g. the-home-lab.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07
# Storefront API private access token (Headless channel). Server only.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Admin API access token from a custom app. Used for order history and
# customer linking. Server only.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Webhook signing secret, used to verify product update webhooks.
SHOPIFY_WEBHOOK_SECRET=
# Market country used for prices and availability.
SHOPIFY_COUNTRY_CODE=IE

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key. Server only. Bypasses RLS: never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Forms ─────────────────────────────────────────────────────────────────
# Contact form messages are POSTed as JSON to this URL (e.g. a helpdesk or
# automation webhook). Without it the form says it is not connected.
CONTACT_WEBHOOK_URL=
# Cloudflare Turnstile spam protection (optional).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Analytics (loaded only after the visitor accepts analytics cookies) ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Business details (hidden or shown as "To confirm" until set) ──────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_CUSTOMER_SERVICE_HOURS=
NEXT_PUBLIC_RESPONSE_TIME=
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_VAT_NUMBER=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_TIKTOK=
