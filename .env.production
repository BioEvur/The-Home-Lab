# Public site address, baked in at build time (canonical links, sitemap, share previews).
NEXT_PUBLIC_SITE_URL=https://thehomelab.ie

# Live site: hides internal placeholders and lets search engines index the site.
NEXT_PUBLIC_SITE_STAGE=production
# Shown on the contact page and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=info@thehomelab.ie
